# USMSB SDK Configuration

# ==================== LLM Provider Configuration ====================
# At least one LLM provider must be configured

# OpenAI Configuration
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4-turbo-preview

# ZhipuAI (GLM) Configuration
ZHIPU_API_KEY=your-zhipu-key
GLM_MODEL=glm-4

# MiniMax Configuration
MINIMAX_API_KEY=your-minimax-key
MINIMAX_MODEL=abab6.5s-chat

# Default LLM Provider
DEFAULT_LLM_PROVIDER=openai
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000

# ==================== Database Configuration ====================
DATABASE_URL=sqlite+aiosqlite:///./usmsb.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/usmsb

# ==================== Redis Configuration ====================
REDIS_URL=redis://localhost:6379/0

# ==================== Blockchain Configuration ====================
ETH_RPC_URL=https://mainnet.base.org

# ==================== Logging Configuration ====================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==================== API Configuration ====================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# ==================== Embedding Configuration ====================
# Choose embedding provider: minimax | sentence_transformers | local_hash
# - minimax: MiniMax Embedding API (paid, default)
# - sentence_transformers: Sentence Transformers local model (free, recommended)
# - local_hash: Local hash pseudo-vector (free, no semantic understanding)
EMBEDDING_PROVIDER=minimax

# ==================== Authentication Configuration ====================
JWT_SECRET=dev-secret-change-in-production
SESSION_DURATION_HOURS=168
